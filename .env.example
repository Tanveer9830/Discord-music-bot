# Discord application credentials. Keep these private; never commit a populated .env file.
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# Set a development guild ID for near-instant command registration during testing.
DEV_GUILD_ID=
# Optional: bot-owner Discord user ID (may be a comma-separated list).
BOT_OWNER_ID=

# Your existing Lavalink v4 server. localhost means the same network namespace as the bot.
# For Docker or Pterodactyl, use the reachable service/container hostname or VPS address instead.
LAVALINK_HOST=127.0.0.1
LAVALINK_PORT=2333
LAVALINK_PASSWORD=
LAVALINK_TLS=false
LAVALINK_NODE_NAME=primary
# Optional multi-node JSON overrides the single-node settings above. Example:
# LAVALINK_NODES=[{"name":"primary","host":"lavalink.internal","port":2333,"password":"replace-me","secure":false}]
LAVALINK_NODES=
# Standard Lavalink v4 source query prefix. The configured Lavalink source manager must support it.
LAVALINK_SEARCH_PREFIX=ytsearch

# Storage is local SQLite for a single bot instance. Back up this directory before upgrades.
DATABASE_PATH=./data/music.sqlite

# node, pm2, docker, or pterodactyl. Informational and used for diagnostics.
DEPLOYMENT_MODE=node
NODE_ENV=production
# Docker Compose bind-mount ownership; installer fills these with the current account IDs.
DOCKER_UID=10001
DOCKER_GID=10001
# manual (recommended) or on-startup. The installer can deploy commands once credentials exist.
COMMAND_REGISTRATION=manual

# Lyrics lookup uses a best-effort public provider and needs no token.
# Optional local policy.
DEFAULT_VOLUME=75
MAX_VOLUME=150
MAX_QUEUE_SIZE=250
IDLE_DISCONNECT_SECONDS=180
LOG_LEVEL=info
