{
  "name": "tanveer-prime-music",
  "version": "1.0.0",
  "private": false,
  "description": "A music-only Discord bot powered by Discord.js v14 and an existing Lavalink v4 server.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "setup": "node scripts/setup.js",
    "validate": "node scripts/diagnostics.js --config-only",
    "diagnostics": "node scripts/diagnostics.js",
    "db:init": "node scripts/db-init.js",
    "commands:deploy": "node scripts/deploy-commands.js",
    "update": "node scripts/update.js",
    "check": "node scripts/check.js",
    "lint": "eslint .",
    "test": "node --test"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "discord.js": "^14.27.0",
    "dotenv": "^18.0.7",
    "shoukaku": "^4.3.0"
  },
  "devDependencies": {
    "eslint": "^10.12.0"
  }
}
